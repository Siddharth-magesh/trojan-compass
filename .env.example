# Trojan Compass backend settings. Copy to .env (never commit .env) and fill in the keys you have.
# Every setting except the API keys has a working default; see backend/app/config/settings.py.

# --- API keys -----------------------------------------------------------------------------------
# Groq (primary LLM): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (fallback LLM): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinecone (guide search over USC documents): https://app.pinecone.io
PINECONE_API_KEY=
# Reserved for future fallbacks; not used by the code yet.
OPEN_ROUTER=
NVIDIA_NIM=

# --- LLM ------------------------------------------------------------------------------------------
# live = always call the LLM; cache = reuse identical past answers from backend/.llm_cache (cheapest for demos);
# mock = canned answers, no keys needed.
LLM_MODE=cache
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=gemini-3.8-flash
MAX_LLM_CALLS_PER_REQUEST=8

# --- Auth -----------------------------------------------------------------------------------------
# At least 32 characters. If empty, a random secret is generated on every start (everyone must log in again
# after a backend restart). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Guide search (retrieval) -----------------------------------------------------------------------
# auto = use Pinecone when local_database/processed/ and PINECONE_API_KEY exist, else a stub that reports why.
# Build processed/ once: cd local_database/scripts && python push_to_pinecone.py --verify-only
RETRIEVAL_BACKEND=auto

# --- Scalability (C4) --------------------------------------------------------------------------------
# memory = single process (default). redis = share sessions, rate limits, quotas, caches and metrics across
# workers/hosts (run uvicorn with --workers N). If Redis is unreachable the API falls back to memory and says so in /api/health.
STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Per student per UTC day (0 disables). Cache hits never count against the token budget.
DAILY_REQUEST_QUOTA=300
DAILY_TOKEN_BUDGET=300000
# disk = replayable dev cache in backend/.llm_cache; shared = state backend with a TTL (LLM_CACHE_TTL_HOURS).
LLM_CACHE_BACKEND=disk
# shared = dev replay cache; student = key also includes the student and the data version (production setting).
LLM_CACHE_SCOPE=shared
# Model tiering: smaller models for planning / tool selection (empty = PRIMARY_MODEL), e.g. openai/gpt-oss-20b.
PLANNER_MODEL=
AGENT_MODEL=
# When set, GET /api/metrics needs "Authorization: Bearer <token>".
METRICS_TOKEN=

# --- Frontend access ------------------------------------------------------------------------------
# Origins allowed to call the API directly (the Vite dev proxy does not need this).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
