# Frontend settings (copy to frontend/.env.local if you need to change them; all are optional).

# Where the browser sends API calls. Keep /api in development: Vite proxies it to BACKEND_URL.
VITE_API_BASE_URL=/api
# true = use the in-browser mock backend (src/mock_api) for offline demos; false = real backend.
VITE_USE_MOCK=false

# Dev server only (read by vite.config.ts, not exposed to the browser).
BACKEND_URL=http://localhost:8000
PORT=5173
