{
  "purpose": "Data handoff for future DATA_GUIDE-compliant ingestion; no uploader or vectors are implemented by this consolidation.",
  "authoritative_guide": "DATA_GUIDE.md",
  "input_manifest": "local_database/registry/readiness_manifest.json",
  "input_root": "local_database/data",
  "exclude_roots": [
    "local_database/source_archive",
    "local_database/legacy_code",
    "local_database/raw",
    "local_database/student_profiles",
    "local_database/processed/legacy_output"
  ],
  "selection": {
    "eligible_input": true,
    "status": "verified",
    "access_level": "public"
  },
  "index": {
    "name": "trojan_compass",
    "dimension": 384,
    "metric": "dotproduct",
    "namespaces": [
      "academic",
      "housing",
      "career",
      "student_services"
    ],
    "upsert_batch_size": 100
  },
  "dense": {
    "model": "BAAI/bge-small-en-v1.5",
    "l2_normalized": true,
    "passage_prefix": "none",
    "query_prefix": "Represent this sentence for searching relevant passages: ",
    "cache_key": [
      "chunk_hash",
      "model"
    ]
  },
  "chunking": {
    "target_tokens": 350,
    "hard_cap_tokens": 450,
    "overlap_tokens": 50,
    "include_context_in_token_limit": true,
    "split_by": "heading_then_paragraph",
    "never_split": [
      "tables",
      "numbered_lists"
    ],
    "truncate_content": false
  },
  "sparse": {
    "method": "bm25",
    "fit_scope": "full_eligible_corpus",
    "refit_growth_fraction": 0.25,
    "explicit_refit_requires_full_reupsert": true
  },
  "metadata": {
    "flat": true,
    "allow_null": false,
    "max_bytes": 40000,
    "fields_contract": "DATA_GUIDE.md: Vector metadata",
    "source_precedence": [
      "official",
      "third_party",
      "synthetic"
    ],
    "deduplicate_by": "chunk_hash",
    "max_also_in": 5
  },
  "query_defaults": {
    "academic_year": "2026-2027",
    "dense_weight": 0.75,
    "keyword_dense_weight": 0.25,
    "retrieve_top_k": 20,
    "rerank_top_k": 5
  },
  "required_future_outputs": [
    "chunks.jsonl",
    "outlines.json",
    "records_index.json",
    "embedding_cache/",
    "bm25_params.json",
    "manifest.json"
  ],
  "required_future_checks": [
    "Lossless heading-aware chunking and token limits",
    "No ingestion of draft, profile or archive data",
    "Full-record exact lookup; unknown values are not confirmed facts",
    "Same-year version replacement and removal of deprecated/deleted vector IDs",
    "Deterministic JWT access filters; namespaces are not authorization",
    "Flat metadata validation and complete provenance",
    "Rebuild when templates or chunk settings change"
  ],
  "api_key_location": ".env:PINECONE_API_KEY",
  "remote_upload_performed": false
}
