{
  "$comment": "Shared file metadata. Document summaries are additionally required by the offline audit; unknown optional facts are omitted. Extra source provenance is preserved locally, never copied wholesale into vector metadata.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "source_name": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Source Name",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "collected_by": {
      "minLength": 1,
      "title": "Collected By",
      "type": "string"
    },
    "collected_date": {
      "format": "date",
      "title": "Collected Date",
      "type": "string"
    },
    "last_verified_date": {
      "format": "date",
      "title": "Last Verified Date",
      "type": "string"
    },
    "academic_year": {
      "pattern": "^\\d{4}-\\d{4}$",
      "title": "Academic Year",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "data_origin": {
      "enum": [
        "public_copy",
        "synthetic"
      ],
      "title": "Data Origin",
      "type": "string"
    },
    "access_level": {
      "enum": [
        "public",
        "synthetic_private"
      ],
      "title": "Access Level",
      "type": "string"
    },
    "owner_student_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "audience": {
      "items": {
        "enum": [
          "all",
          "international",
          "undergraduate",
          "graduate"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Audience",
      "type": "array"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9_]+$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 3,
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "title",
    "source_name",
    "source_url",
    "collected_by",
    "collected_date",
    "last_verified_date",
    "academic_year",
    "version",
    "status",
    "data_origin",
    "access_level",
    "audience",
    "tags"
  ],
  "title": "Meta",
  "type": "object"
}
