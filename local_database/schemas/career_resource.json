{
  "$comment": "Schema for career_resource; absent optional facts must be omitted in stored data.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_name": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Source Name",
          "type": "string"
        },
        "checked_date": {
          "format": "date",
          "title": "Checked Date",
          "type": "string"
        },
        "access_status": {
          "enum": [
            "public",
            "gated",
            "fetch_failed",
            "rate_limited",
            "broken",
            "search_only"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "source_name",
        "checked_date",
        "access_status",
        "observation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "source_name": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Source Name",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "last_verified_date": {
      "format": "date",
      "title": "Last Verified Date",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "verification_notes": {
      "minLength": 1,
      "title": "Verification Notes",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9_]+$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 3,
      "title": "Tags",
      "type": "array"
    },
    "resource_id": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Resource Id",
      "type": "string"
    },
    "resource_type": {
      "enum": [
        "campus_employer",
        "job_platform",
        "career_service",
        "networking",
        "research_program",
        "student_organization",
        "policy"
      ],
      "title": "Resource Type",
      "type": "string"
    },
    "official_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Official Url",
      "type": "string"
    },
    "account_requirements": {
      "minLength": 1,
      "title": "Account Requirements",
      "type": "string"
    },
    "access_status": {
      "enum": [
        "public",
        "gated",
        "fetch_failed",
        "search_only"
      ],
      "title": "Access Status",
      "type": "string"
    },
    "search_functionality": {
      "minLength": 1,
      "title": "Search Functionality",
      "type": "string"
    },
    "usage_steps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Usage Steps",
      "type": "array"
    },
    "recruitment_status": {
      "enum": [
        "active",
        "upcoming",
        "closed",
        "unverified",
        "no_opening_verified",
        "interest_only",
        "not_recruiting"
      ],
      "title": "Recruitment Status",
      "type": "string"
    },
    "eligibility_notes": {
      "minLength": 1,
      "title": "Eligibility Notes",
      "type": "string"
    },
    "numerical_facts": {
      "anyOf": [
        {
          "patternProperties": {
            "^[a-z0-9_]+$": {
              "type": "number"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Numerical Facts"
    }
  },
  "required": [
    "title",
    "description",
    "source_name",
    "source_url",
    "last_verified_date",
    "evidence",
    "verification_notes",
    "tags",
    "resource_id",
    "resource_type",
    "official_url",
    "account_requirements",
    "access_status",
    "search_functionality",
    "usage_steps",
    "recruitment_status",
    "eligibility_notes"
  ],
  "title": "CareerResource",
  "type": "object"
}
