{
  "$comment": "Schema for local data validation; retain additional source facts.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service directory record",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "official_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "login_required": {
      "type": "boolean"
    },
    "replicated": {
      "type": "boolean"
    },
    "common_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "access_path": {
      "type": "string",
      "minLength": 1
    },
    "owner_office": {
      "type": "string",
      "minLength": 1
    },
    "contact_email": {
      "type": "string",
      "minLength": 1
    },
    "contact_phone": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "service_id",
    "name",
    "purpose",
    "official_url",
    "login_required",
    "replicated",
    "common_tasks"
  ]
}
