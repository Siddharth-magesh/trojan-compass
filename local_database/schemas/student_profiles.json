{
  "$comment": "Schema for local data validation; retain additional source facts.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic student profile",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "program": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "undergraduate",
        "graduate"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed_courses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "housing_budget_usd": {
      "type": "number"
    },
    "job_interests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "student_id",
    "name",
    "program",
    "level",
    "country",
    "interests",
    "completed_courses",
    "housing_budget_usd",
    "job_interests"
  ]
}
