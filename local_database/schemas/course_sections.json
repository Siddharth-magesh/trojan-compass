{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course section record",
  "type": "object",
  "properties": {
    "section_id": {
      "type": "string",
      "minLength": 1
    },
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "instructor": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "start_time": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$|^TBA$"
    },
    "end_time": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$|^TBA$"
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "enum": [
        "in_person",
        "online",
        "hybrid",
        "unverified"
      ]
    },
    "source_section_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "section_id",
    "course_id",
    "term",
    "instructor",
    "days",
    "start_time",
    "end_time",
    "location",
    "modality"
  ],
  "$comment": "Section snapshots preserve explicit TBA times and unverified modality/location. These sentinel strings are unknown facts, never confirmed availability or numeric scheduling inputs."
}
