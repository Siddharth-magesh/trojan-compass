{
  "$comment": "Schema for source_checks; absent optional facts must be omitted in stored data.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_name": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Source Name",
          "type": "string"
        },
        "checked_date": {
          "format": "date",
          "title": "Checked Date",
          "type": "string"
        },
        "access_status": {
          "enum": [
            "public",
            "gated",
            "fetch_failed",
            "rate_limited",
            "broken",
            "search_only"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "source_name",
        "checked_date",
        "access_status",
        "observation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "purpose",
    "checks"
  ],
  "title": "SourceChecks",
  "type": "object"
}
