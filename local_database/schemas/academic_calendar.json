{
  "$comment": "Schema for local data validation; retain additional source facts.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deadline record",
  "type": "object",
  "properties": {
    "deadline_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "deadline_id",
    "title",
    "date",
    "term",
    "applies_to",
    "description"
  ]
}
