          "group_id": "adviser_approved_coursework",
          "name": "Adviser-approved coursework",
          "units_required": 28,
          "selection": "open",
          "notes": [
            "At least 20 of the 28 units must be taken in electrical engineering; those not in EE require written adviser approval and must be technical in nature.",
            "At least 19 adviser-approved units must be taken at the 500- or 600-level; no more than three courses (maximum 12 units) may be counted at the 400-level.",
            "These overlap: one EE 500-level course counts toward both. See `limits` for every rule."
          ]
