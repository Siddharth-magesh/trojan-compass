{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta fields required on every data file",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "collected_by": {
      "type": "string",
      "minLength": 1
    },
    "collected_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_verified_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "academic_year": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{4}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "deprecated"
      ]
    },
    "data_origin": {
      "enum": [
        "public_copy",
        "synthetic"
      ]
    },
    "access_level": {
      "enum": [
        "public",
        "synthetic_private"
      ]
    },
    "owner_student_id": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "all",
          "international",
          "undergraduate",
          "graduate"
        ]
      }
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "title",
    "source_name",
    "source_url",
    "collected_by",
    "collected_date",
    "last_verified_date",
    "version",
    "status",
    "data_origin",
    "audience",
    "tags"
  ],
  "if": {
    "properties": {
      "access_level": {
        "const": "synthetic_private"
      }
    },
    "required": [
      "access_level"
    ]
  },
  "then": {
    "required": [
      "owner_student_id"
    ]
  }
}
