{
  "$comment": "Schema for career_opportunity; absent optional facts must be omitted in stored data.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_name": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Source Name",
          "type": "string"
        },
        "checked_date": {
          "format": "date",
          "title": "Checked Date",
          "type": "string"
        },
        "access_status": {
          "enum": [
            "public",
            "gated",
            "fetch_failed",
            "rate_limited",
            "broken",
            "search_only"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "source_name",
        "checked_date",
        "access_status",
        "observation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "source_name": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Source Name",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "last_verified_date": {
      "format": "date",
      "title": "Last Verified Date",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "verification_notes": {
      "minLength": 1,
      "title": "Verification Notes",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9_]+$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 3,
      "title": "Tags",
      "type": "array"
    },
    "opportunity_id": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Opportunity Id",
      "type": "string"
    },
    "organization": {
      "minLength": 1,
      "title": "Organization",
      "type": "string"
    },
    "opportunity_type": {
      "enum": [
        "paid_employment",
        "research",
        "unpaid_research",
        "volunteer",
        "internship",
        "event"
      ],
      "title": "Opportunity Type",
      "type": "string"
    },
    "recruitment_status": {
      "enum": [
        "active",
        "upcoming",
        "closed",
        "unverified",
        "no_opening_verified",
        "interest_only",
        "not_recruiting"
      ],
      "title": "Recruitment Status",
      "type": "string"
    },
    "status_reason": {
      "minLength": 1,
      "title": "Status Reason",
      "type": "string"
    },
    "compensation_status": {
      "enum": [
        "paid",
        "unpaid",
        "not_stated"
      ],
      "title": "Compensation Status",
      "type": "string"
    },
    "international_eligibility": {
      "enum": [
        "yes",
        "no",
        "unverified"
      ],
      "title": "International Eligibility",
      "type": "string"
    },
    "student_eligibility": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Student Eligibility",
      "type": "array"
    },
    "required_skills": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Skills",
      "type": "array"
    },
    "application_instructions": {
      "minLength": 1,
      "title": "Application Instructions",
      "type": "string"
    },
    "apply_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Apply Url",
      "type": "string"
    },
    "lab_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lab Id"
    },
    "recruitment_contact": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recruitment Contact"
    },
    "location": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "posting_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Posting Date"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "start_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Date"
    },
    "end_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Date"
    },
    "hourly_pay_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hourly Pay Usd"
    },
    "annual_pay_by_location_usd": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annual Pay By Location Usd"
    },
    "hours_per_week": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 168,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hours Per Week"
    },
    "break_hours_per_week": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 168,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Break Hours Per Week"
    },
    "duration_weeks": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Weeks"
    },
    "commitment_months": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commitment Months"
    }
  },
  "required": [
    "title",
    "description",
    "source_name",
    "source_url",
    "last_verified_date",
    "evidence",
    "verification_notes",
    "tags",
    "opportunity_id",
    "organization",
    "opportunity_type",
    "recruitment_status",
    "status_reason",
    "compensation_status",
    "international_eligibility",
    "student_eligibility",
    "application_instructions",
    "apply_url"
  ],
  "title": "Opportunity",
  "type": "object"
}
