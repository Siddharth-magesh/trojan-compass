{
  "$comment": "Schema for job_listing; absent optional facts must be omitted in stored data.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_name": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Source Name",
          "type": "string"
        },
        "checked_date": {
          "format": "date",
          "title": "Checked Date",
          "type": "string"
        },
        "access_status": {
          "enum": [
            "public",
            "gated",
            "fetch_failed",
            "rate_limited",
            "broken",
            "search_only"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "source_name",
        "checked_date",
        "access_status",
        "observation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "source_name": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Source Name",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "last_verified_date": {
      "format": "date",
      "title": "Last Verified Date",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "verification_notes": {
      "minLength": 1,
      "title": "Verification Notes",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9_]+$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 3,
      "title": "Tags",
      "type": "array"
    },
    "job_id": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Job Id",
      "type": "string"
    },
    "employer": {
      "minLength": 1,
      "title": "Employer",
      "type": "string"
    },
    "job_type": {
      "minLength": 1,
      "title": "Job Type",
      "type": "string"
    },
    "location": {
      "minLength": 1,
      "title": "Location",
      "type": "string"
    },
    "hourly_pay_usd": {
      "minimum": 0,
      "title": "Hourly Pay Usd",
      "type": "number"
    },
    "hours_per_week": {
      "exclusiveMinimum": 0,
      "maximum": 168,
      "title": "Hours Per Week",
      "type": "number"
    },
    "required_skills": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Skills",
      "type": "array"
    },
    "international_eligibility": {
      "enum": [
        "yes",
        "no",
        "unverified"
      ],
      "title": "International Eligibility",
      "type": "string"
    },
    "deadline": {
      "format": "date",
      "title": "Deadline",
      "type": "string"
    },
    "apply_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Apply Url",
      "type": "string"
    },
    "recruitment_status": {
      "enum": [
        "active",
        "upcoming",
        "closed",
        "unverified",
        "no_opening_verified",
        "interest_only",
        "not_recruiting"
      ],
      "title": "Recruitment Status",
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "source_name",
    "source_url",
    "last_verified_date",
    "evidence",
    "verification_notes",
    "tags",
    "job_id",
    "employer",
    "job_type",
    "location",
    "hourly_pay_usd",
    "hours_per_week",
    "required_skills",
    "international_eligibility",
    "deadline",
    "apply_url",
    "recruitment_status"
  ],
  "title": "JobListing",
  "type": "object"
}
