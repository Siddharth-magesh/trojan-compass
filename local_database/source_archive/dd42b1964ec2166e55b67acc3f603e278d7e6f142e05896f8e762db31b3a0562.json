{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job listing record",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "employer": {
      "type": "string",
      "minLength": 1
    },
    "job_type": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "hourly_pay_usd": {
      "type": "number"
    },
    "hours_per_week": {
      "type": "number"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "international_eligibility": {
      "enum": [
        "yes",
        "no",
        "unverified"
      ]
    },
    "deadline": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "apply_url": {
      "type": "string",
      "pattern": "^https?://"
    }
  },
  "required": [
    "job_id",
    "title",
    "employer",
    "job_type",
    "location",
    "hourly_pay_usd",
    "hours_per_week",
    "required_skills",
    "international_eligibility",
    "deadline",
    "apply_url"
  ]
}
